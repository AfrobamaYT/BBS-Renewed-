            /* Restore this replay's entity to the live film tick. */
            if (touched)
            {
                this.bbstools$bakePose(e, e.replay().getTick(filmTick));
                BBSPerfConfig.bgBakeRestores++;
            }

            if (AnimationBakeCache.firstUncachedTick(e.entity(), expected) < 0)
            {
                /* Completed this replay → advance to the next one. */
                idx++;
                examined++;
            }
            else
            {
                /* Budget exhausted mid-replay → resume here next frame. */
                break;
            }
        }

        this.bbstools$bakeCursor = idx;
    }

    /** Pose one entity exactly as BaseFilmController.updateEntities would for a
     *  given tick — minus applyClientActions (item/HUD/particles), which don't
     *  affect bone matrices and would cause off-screen side effects during a
     *  bake. setAge+update+form.update + keyframes.apply matches the live path. */
    private void bbstools$bakePose(EligibleReplay e, int tick)
    {
        this.updateEntityAndForm(e.entity(), tick);
        /* updateEntityAndForm → setAge(tick)+update() leaves age=tick+1, but
         * bakeRecord keys the cache by getAge() while this loop's skip-check
         * uses `tick` → off-by-one freeze at half. Re-pin age to tick. */
        e.entity().setAge(tick);
        e.replay().keyframes.apply(tick, e.entity());
    }

    private static ModelFormRenderer bbstools$rendererFor(Form form)
    {
        Object r = FormUtilsClient.getRenderer(form);
        return (r instanceof ModelFormRenderer mfr) ? mfr : null;
    }

    private int bbstools$exception()
    {
        return ((BaseFilmController) (Object) this).exception;
    }

}
